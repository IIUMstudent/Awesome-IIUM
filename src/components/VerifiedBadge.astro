---
/**
 * VerifiedBadge component
 *
 * Purpose: Display a visual badge for verified, featured, or official resources.
 * Usage: <VerifiedBadge text="Verified" variant="verified" />
 * Props: text?: string, variant?: 'verified' | 'featured' | 'official'.
 * Client behavior: Static markup only (no client-side JS).
 * API dependencies: None.
 */
// biome-ignore lint/correctness/noUnusedVariables: Used in template
interface Props {
	text?: string;
	variant?: 'verified' | 'featured' | 'official';
}

// biome-ignore lint/correctness/noUnusedVariables: Used in template
const { text = 'Verified', variant = 'verified' } = Astro.props;

const variants = {
	verified: {
		icon: '✓',
		class: 'badge-verified',
		title: 'This resource has been verified by maintainers',
	},
	featured: {
		icon: '★',
		class: 'badge-featured',
		title: 'Featured resource',
	},
	official: {
		icon: '🏛',
		class: 'badge-official',
		title: 'Official IIUM resource',
	},
};

// biome-ignore lint/correctness/noUnusedVariables: Used in template
const config = variants[variant];
---

<span class={`badge ${config.class}`} title={config.title}>
  <span class="badge-icon">{config.icon}</span>
  <span class="badge-text">{text}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }

  .badge-verified {
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
  }

  .badge-featured {
    background: var(--aw-color-gold-low);
    color: var(--aw-color-gold-high);
  }

  .badge-official {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .badge-icon {
    font-size: 0.625rem;
  }

  .badge-text {
    line-height: 1;
  }
</style>
