# Environment Variables for Awesome IIUM

# Analytics
# GoatCounter privacy-first analytics endpoint
# Optional: Set to your GoatCounter instance if you want custom analytics
# GOATCOUNTER_ENDPOINT=https://your-domain.goatcounter.com/count

# Build Configuration
# Optional: Set to 'development' or 'production'
# NODE_ENV=production

# API Configuration
# GitHub API Token (optional but recommended)
# Increases rate limit from 60 to 5000 requests/hour for dashboard components
# Create token at: https://github.com/settings/tokens
# Required scopes: None (public repo read access only)
# Used by: ActivityFeed, Leaderboard, NewThisWeek components
# GITHUB_TOKEN=your_github_token_here

# PWA Configuration
# Optional: Set to false to disable PWA service worker in development
# ENABLE_PWA=true


