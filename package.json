{
	"name": "awesome-iium",
	"version": "1.0.0",
	"description": "A curated list of resources for IIUM",
	"packageManager": "pnpm@10.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/iiumstudent/Awesome-IIUM.git"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
		"test:lighthouse": "lhci autorun",
		"lint:md": "markdownlint '*.md' 'src/**/*.{md,mdx}' --ignore node_modules",
		"format:md": "prettier --write 'src/**/*.{md,mdx}'",
		"lint:js": "biome check .",
		"format:js": "biome format --write .",
		"lint": "pnpm run lint:js && pnpm run lint:md",
		"format": "pnpm run format:js && pnpm run format:md",
		"prepare": "husky"
	},
	"lint-staged": {
		"src/**/*.{js,ts,astro}": [
			"biome check --fix"
		],
		"src/**/*.{md,mdx}": [
			"prettier --write",
			"markdownlint"
		]
	},
	"pnpm": {
		"overrides": {
			"tmp": ">=0.2.4",
			"@isaacs/brace-expansion": ">=5.0.1"
		}
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.15",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.64.0",
		"@vitest/coverage-v8": "5.0.4",
		"@vitest/ui": "^5.0.4",
		"awesome-lint": "^2.3.0",
		"happy-dom": "^21.0.1",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"markdownlint-cli": "^0.49.1",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.9.10",
		"rollup-plugin-visualizer": "^7.1.1",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.42.6",
		"@vite-pwa/astro": "^1.2.0",
		"astro": "^7.3.8",
		"sharp": "^0.35.5",
		"workbox-window": "^7.4.1"
	}
}
